DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mlservice
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
MODEL_STORAGE_PATH=./data/models
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_REVIEW_CHARS=8000
MAX_MODEL_UPLOAD_MB=200
ALLOWED_LORA_BASES=distilbert-base-uncased

# Comma-separated emails that become role=admin on register and on each login.
ADMIN_BOOTSTRAP_EMAILS=admin@example.com